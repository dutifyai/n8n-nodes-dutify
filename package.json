{
	"name": "@dutifyai/n8n-nodes-dutify",
	"version": "0.1.3",
	"description": "n8n community nodes for Dutify: Dutify Cloud projects and tasks, Codexum docs and wiki, Roadmarq feedback, feature requests and bugs, and Dutify Hub meetings, recordings and AI Coworker, with a trigger for their events and processed meetings.",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://dutify.ai",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dutifyai/n8n-nodes-dutify.git"
	},
	"keywords": [
		"n8n-community-node-package",
		"dutify",
		"dutify-cloud",
		"codexum",
		"roadmarq",
		"dutify-hub",
		"ai-coworker",
		"project-management",
		"tasks",
		"wiki",
		"feature-requests",
		"meeting-notes"
	],
	"author": {
		"name": "Dutify",
		"email": "info@dutify.ai"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run test/unit",
		"test:live": "vitest run test/live --no-file-parallelism --testTimeout=20000",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DutifyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Dutify/Dutify.node.js",
			"dist/nodes/DutifyTrigger/DutifyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^20.19.43",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vite": "^7.3.7",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
